# =============================================================================
# SMART SHOE FRONTEND - PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# Production configuration for Smart Shoe mobile and web applications
# Server Location: AWS EC2 Instance (13.201.120.175)

# =============================================================================
# API CONFIGURATION
# =============================================================================
VITE_API_URL=http://13.201.120.175:8080
VITE_API_BASE_URL=http://13.201.120.175:8080/api
VITE_ML_API_URL=http://13.201.120.175:8080/api/ml
VITE_WEBSOCKET_URL=ws://13.201.120.175:8080/ws

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
VITE_APP_NAME=Smart Shoe - Diabetic Monitoring
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=production
VITE_APP_DEBUG=false

# =============================================================================
# MOBILE APP CONFIGURATION
# =============================================================================
VITE_MOBILE_APP_ID=com.smartshoe.app
VITE_MOBILE_APP_NAME=Smart Shoe
VITE_MOBILE_DEEP_LINK_SCHEME=smartshoe

# =============================================================================
# FEATURE FLAGS
# =============================================================================
VITE_ENABLE_BLUETOOTH=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_CAMERA=true
VITE_ENABLE_BIOMETRIC_AUTH=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CRASH_REPORTING=true

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
VITE_ENABLE_HTTPS_REDIRECT=false
VITE_API_TIMEOUT=30000
VITE_REQUEST_RETRY_ATTEMPTS=3
VITE_SESSION_TIMEOUT=1800000
VITE_TOKEN_REFRESH_THRESHOLD=300000

# =============================================================================
# THIRD-PARTY SERVICES
# =============================================================================
# Firebase (for push notifications)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Analytics (Google Analytics, Mixpanel, etc.)
VITE_GOOGLE_ANALYTICS_ID=your_ga_tracking_id
VITE_MIXPANEL_TOKEN=your_mixpanel_token

# Error Tracking (Sentry)
VITE_SENTRY_DSN=your_sentry_dsn
VITE_SENTRY_ENVIRONMENT=production

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
VITE_ENABLE_SERVICE_WORKER=true
VITE_CACHE_STRATEGY=cache-first
VITE_OFFLINE_CACHE_DURATION=86400000
VITE_API_CACHE_DURATION=300000

# =============================================================================
# MEDICAL COMPLIANCE
# =============================================================================
VITE_HIPAA_COMPLIANT=true
VITE_ENABLE_AUDIT_LOGGING=true
VITE_DATA_ENCRYPTION_ENABLED=true
VITE_BIOMETRIC_AUTH_REQUIRED=true
VITE_SESSION_RECORDING_DISABLED=true

# =============================================================================
# UI/UX CONFIGURATION
# =============================================================================
VITE_THEME_MODE=light
VITE_ENABLE_DARK_MODE=true
VITE_DEFAULT_LANGUAGE=en
VITE_SUPPORTED_LANGUAGES=en,es,fr,de
VITE_ENABLE_HAPTIC_FEEDBACK=true
VITE_ANIMATION_DURATION=300

# =============================================================================
# DEVELOPMENT/DEBUG (DISABLED IN PRODUCTION)
# =============================================================================
VITE_ENABLE_REDUX_DEVTOOLS=false
VITE_ENABLE_CONSOLE_LOGS=false
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_ERROR_BOUNDARY=true

# =============================================================================
# BUILD CONFIGURATION
# =============================================================================
VITE_BUILD_TARGET=production
VITE_BUNDLE_ANALYZER=false
VITE_MINIFY=true
VITE_SOURCE_MAPS=false
VITE_TREE_SHAKING=true

# =============================================================================
# CONTENT SECURITY POLICY
# =============================================================================
VITE_CSP_ENABLED=true
VITE_ALLOWED_HOSTS=13.201.120.175,smartshoe.com,*.smartshoe.com
VITE_ALLOWED_ORIGINS=http://13.201.120.175:8080,https://smartshoe.com