# =============================================================================
# SMART SHOE FRONTEND - DEVELOPMENT ENVIRONMENT VARIABLES
# =============================================================================
# Development configuration for local development and testing

# =============================================================================
# API CONFIGURATION
# =============================================================================
VITE_API_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080/api
VITE_ML_API_URL=http://localhost:8080/api/ml
VITE_WEBSOCKET_URL=ws://localhost:8080/ws

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
VITE_APP_NAME=Smart Shoe - Development
VITE_APP_VERSION=1.0.0-dev
VITE_APP_ENVIRONMENT=development
VITE_APP_DEBUG=true

# =============================================================================
# MOBILE APP CONFIGURATION
# =============================================================================
VITE_MOBILE_APP_ID=com.smartshoe.app.dev
VITE_MOBILE_APP_NAME=Smart Shoe Dev
VITE_MOBILE_DEEP_LINK_SCHEME=smartshoe-dev

# =============================================================================
# FEATURE FLAGS (ENABLED FOR TESTING)
# =============================================================================
VITE_ENABLE_BLUETOOTH=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_CAMERA=true
VITE_ENABLE_BIOMETRIC_AUTH=false
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_CRASH_REPORTING=false

# =============================================================================
# SECURITY CONFIGURATION (RELAXED FOR DEVELOPMENT)
# =============================================================================
VITE_ENABLE_HTTPS_REDIRECT=false
VITE_API_TIMEOUT=60000
VITE_REQUEST_RETRY_ATTEMPTS=1
VITE_SESSION_TIMEOUT=3600000
VITE_TOKEN_REFRESH_THRESHOLD=600000

# =============================================================================
# THIRD-PARTY SERVICES (DEVELOPMENT/TEST KEYS)
# =============================================================================
VITE_FIREBASE_API_KEY=dev_firebase_key
VITE_FIREBASE_PROJECT_ID=smartshoe-dev
VITE_FIREBASE_MESSAGING_SENDER_ID=dev_sender_id
VITE_FIREBASE_APP_ID=dev_app_id

VITE_GOOGLE_ANALYTICS_ID=dev_ga_id
VITE_MIXPANEL_TOKEN=dev_mixpanel_token
VITE_SENTRY_DSN=dev_sentry_dsn
VITE_SENTRY_ENVIRONMENT=development

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
VITE_ENABLE_SERVICE_WORKER=false
VITE_CACHE_STRATEGY=network-first
VITE_OFFLINE_CACHE_DURATION=3600000
VITE_API_CACHE_DURATION=0

# =============================================================================
# MEDICAL COMPLIANCE (RELAXED FOR DEVELOPMENT)
# =============================================================================
VITE_HIPAA_COMPLIANT=false
VITE_ENABLE_AUDIT_LOGGING=true
VITE_DATA_ENCRYPTION_ENABLED=false
VITE_BIOMETRIC_AUTH_REQUIRED=false
VITE_SESSION_RECORDING_DISABLED=false

# =============================================================================
# UI/UX CONFIGURATION
# =============================================================================
VITE_THEME_MODE=light
VITE_ENABLE_DARK_MODE=true
VITE_DEFAULT_LANGUAGE=en
VITE_SUPPORTED_LANGUAGES=en
VITE_ENABLE_HAPTIC_FEEDBACK=false
VITE_ANIMATION_DURATION=100

# =============================================================================
# DEVELOPMENT/DEBUG (ENABLED)
# =============================================================================
VITE_ENABLE_REDUX_DEVTOOLS=true
VITE_ENABLE_CONSOLE_LOGS=true
VITE_ENABLE_PERFORMANCE_MONITORING=false
VITE_ENABLE_ERROR_BOUNDARY=true

# =============================================================================
# BUILD CONFIGURATION
# =============================================================================
VITE_BUILD_TARGET=development
VITE_BUNDLE_ANALYZER=false
VITE_MINIFY=false
VITE_SOURCE_MAPS=true
VITE_TREE_SHAKING=false

# =============================================================================
# CONTENT SECURITY POLICY (RELAXED)
# =============================================================================
VITE_CSP_ENABLED=false
VITE_ALLOWED_HOSTS=localhost,127.0.0.1
VITE_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080