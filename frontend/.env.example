# Frontend Environment Configuration
# Copy this file to .env.local and update with your values

# API Configuration
VITE_API_BASE_URL=http://localhost:8080/api
VITE_ML_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8080

# Application Configuration
VITE_APP_NAME=Smart Shoe Monitor
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Professional diabetic neuropathy monitoring platform

# Authentication Configuration
VITE_AUTH_PROVIDER=jwt
VITE_AUTH_REDIRECT_URL=http://localhost:3000/login
VITE_AUTH_LOGOUT_URL=http://localhost:3000/login

# Feature Flags
VITE_ENABLE_PWA=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# Third-party Services
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=
VITE_HOTJAR_ID=

# Security
VITE_ENCRYPTION_KEY=your-encryption-key-here
VITE_CSP_NONCE=

# Development
VITE_DEV_TOOLS=true
VITE_MOCK_API=false
VITE_STORYBOOK=false

# Build Configuration
VITE_BUILD_ANALYZE=false
VITE_BUILD_SOURCEMAPS=false
VITE_BUILD_MINIFY=true

# Performance
VITE_CACHE_TTL=300000
VITE_REQUEST_TIMEOUT=30000
VITE_RETRY_ATTEMPTS=3

# Monitoring
VITE_MONITORING_ENABLED=true
VITE_METRICS_ENDPOINT=http://localhost:9090
VITE_HEALTH_CHECK_INTERVAL=30000

# Accessibility
VITE_A11Y_ENABLED=true
VITE_A11Y_ANNOUNCEMENTS=true
VITE_A11Y_HIGH_CONTRAST=false

# Internationalization
VITE_I18N_ENABLED=true
VITE_DEFAULT_LOCALE=en
VITE_SUPPORTED_LOCALES=en,es,fr

# Medical Configuration
VITE_MEDICAL_UNITS=metric
VITE_MEDICAL_PRECISION=2
VITE_MEDICAL_ALERTS_ENABLED=true

# Device Configuration
VITE_DEVICE_DISCOVERY_ENABLED=true
VITE_DEVICE_AUTO_CONNECT=true
VITE_DEVICE_SIMULATION=false

# Testing
VITE_TEST_USER_EMAIL=test@example.com
VITE_TEST_USER_PASSWORD=testpassword
VITE_TEST_PATIENT_ID=patient-001